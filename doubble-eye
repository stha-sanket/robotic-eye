
#include <U8g2lib.h>

// SH1106 1.3" 128x64 I2C
U8G2_SH1106_128X64_NONAME_F_HW_I2C u8g2(U8G2_R0, /* reset=*/ U8X8_PIN_NONE);

/* -------------------------------------------------------------
   Eye geometry (centered on the 128×64 screen)
   ------------------------------------------------------------- */
#define LEFT_EYE_X   38          // center of left eye
#define RIGHT_EYE_X  90          // center of right eye
#define EYE_Y        32          // vertical center (same for both)
#define EYE_W        28          // half-width  of the eye ellipse
#define EYE_H        24          // half-height of the eye ellipse
#define IRIS_W       20
#define IRIS_H       18
#define PUPIL_R      9
#define HIGHLIGHT_R  4

/* -------------------------------------------------------------
   Animation timing
   ------------------------------------------------------------- */
unsigned long prevBlink = 0;
const unsigned long BLINK_INTERVAL = 3000;   // avg time between blinks
const unsigned long BLINK_DURATION = 140;    // how fast the lid moves

unsigned long prevMove = 0;
const unsigned long MOVE_INTERVAL = 1800;    // how often eyes look around

bool blinking = false;
unsigned long blinkStart = 0;

/* current pupil offset (shared by both eyes) */
int pupilX = 0, pupilY = 0;

/* -------------------------------------------------------------
   Helper: draw a single eye
   ------------------------------------------------------------- */
void drawEye(int cx, bool lidOpen) {
  // ----- outer metal rim (thick ellipse) -----
  u8g2.drawEllipse(cx, EYE_Y, EYE_W, EYE_H, U8G2_DRAW_ALL);
  u8g2.drawEllipse(cx, EYE_Y, EYE_W-1, EYE_H-1, U8G2_DRAW_ALL);

  if (!lidOpen) {
    // lid closed → just a thin line
    u8g2.drawLine(cx-EYE_W, EYE_Y, cx+EYE_W, EYE_Y);
    return;
  }

  // ----- iris (metallic ring) -----
  u8g2.drawEllipse(cx + pupilX, EYE_Y + pupilY, IRIS_W, IRIS_H, U8G2_DRAW_ALL);
  u8g2.drawEllipse(cx + pupilX, EYE_Y + pupilY, IRIS_W-2, IRIS_H-2, U8G2_DRAW_ALL);

  // ----- pupil (black) -----
  u8g2.setDrawColor(0);
  u8g2.drawDisc(cx + pupilX, EYE_Y + pupilY, PUPIL_R, U8G2_DRAW_ALL);
  u8g2.setDrawColor(1);

  // ----- bright highlight -----
  int hx = cx + pupilX - 5;
  int hy = EYE_Y + pupilY - 5;
  u8g2.drawDisc(hx, hy, HIGHLIGHT_R, U8G2_DRAW_ALL);
}

/* ------------------------------------------------------------- */
void setup() {
  u8g2.begin();
  randomSeed(analogRead(0));
}

/* ------------------------------------------------------------- */
void loop() {
  unsigned long now = millis();

  /* ---------- BLINK CONTROL ---------- */
  if (!blinking && now - prevBlink >= BLINK_INTERVAL + random(-1200, 1200)) {
    blinking = true;
    blinkStart = now;
    prevBlink = now;
  }

  float lid = 1.0;                     // 1 = fully open, 0 = fully closed
  if (blinking) {
    float prog = (float)(now - blinkStart) / BLINK_DURATION;
    if (prog < 0.5f) lid = 1.0f - prog * 2.0f;          // close
    else           lid = (prog - 0.5f) * 2.0f;          // open
    if (prog >= 1.0f) blinking = false;
  }

  /* ---------- PUPIL MOVEMENT ---------- */
  if (now - prevMove >= MOVE_INTERVAL) {
    pupilX = random(-8, 9);
    pupilY = random(-6, 7);
    prevMove = now;
  }

  /* ---------- DRAW ---------- */
  u8g2.clearBuffer();

  bool open = (lid > 0.05f);           // tiny threshold avoids flicker
  drawEye(LEFT_EYE_X,  open);
  drawEye(RIGHT_EYE_X, open);

  // optional: draw a thin horizontal line for the "lid" when partly closed
  if (!open && lid > 0.0f) {
    int y = EYE_Y - (int)(EYE_H * lid);
    u8g2.drawLine(0, y, 127, y);
  }

  u8g2.sendBuffer();
  delay(12);                           // ~80 fps, smooth enough
}
